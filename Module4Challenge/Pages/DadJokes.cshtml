@page
@model Module4Challenge.Pages.DadJokesModel
@{
    ViewData["Title"] = "Dad Joke Generator";
}

<div class="container mt-5">

    <h1 class="text-center">Dad Joke Generator</h1>

    <p class="text-center">
        Welcome to Dads-R-Us! Enjoy some dad jokes.
    </p>

    <div class="row">

        @for (int i = 0; i < Model.CurrentJokes.Length; i++)
        {
            <div class="col mb-3">

                <div class="card">

                    <div class="card-body">

                        <h5 class="card-title">Dad Joke</h5>

                        <p class="card-text">
                            @Model.CurrentJokes[i]
                        </p>

                    </div>

                </div>

            </div>
        }

    </div>

    <div class="text-center">

        <form method="post">

            <button type="submit" class="btn btn-primary">
                More Jokes
            </button>

        </form>

    </div>

</div>